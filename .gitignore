# Local Python environments and caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local tooling, editor state, and temporary files
.DS_Store
.vscode/
.idea/
*.swp
*.tmp
*.bak

# Sensitive local configuration and ad-hoc downloads
.env
.env.*
!*.env.example
credentials/
secrets/
data/incoming/

# Never commit transient logs
*.log
